{
  "name": "panefold",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental deterministic, accessible workspace runtime for the web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natanelia/panefold.git"
  },
  "bugs": {
    "url": "https://github.com/natanelia/panefold/issues"
  },
  "homepage": "https://natanelia.github.io/panefold/",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm build:site",
    "build:packages": "pnpm -r --filter './packages/**' run build",
    "build:site": "pnpm --filter '@panefold/demo^...' run build && PANEFOLD_DEMO_BASE=/panefold/atlas/ pnpm --filter @panefold/demo run build && pnpm --filter @panefold/site run build",
    "dev": "pnpm build:packages && pnpm --filter @panefold/demo run dev",
    "dev:site": "pnpm build:packages && node scripts/dev-marketing-site.mjs",
    "preview": "pnpm --filter @panefold/demo run preview",
    "preview:site": "pnpm --filter @panefold/site run preview",
    "typecheck": "pnpm build:packages && tsc --noEmit -p tsconfig.json",
    "test": "pnpm build:packages && vitest run",
    "test:watch": "pnpm build:packages && vitest",
    "test:e2e": "playwright test",
    "test:site:e2e": "playwright test --config playwright.site.config.ts",
    "lint": "eslint . --max-warnings=0 && pnpm architecture:check",
    "security:check": "node scripts/security-check.mjs",
    "performance:smoke": "node scripts/performance-smoke.mjs",
    "marketing:capture": "node scripts/capture-marketing-video.mjs",
    "marketing:social": "node scripts/capture-social-card.mjs",
    "requirements:generate": "node scripts/generate-requirements.mjs",
    "requirements:check": "pnpm requirements:generate && git diff --exit-code -- conformance/requirements.json",
    "conformance:data:generate": "node scripts/generate-conformance-data.mjs",
    "conformance:data:check": "pnpm conformance:data:generate && git diff --exit-code -- conformance/capabilities.json conformance/evidence.json conformance/gates.json conformance/traces.json",
    "conformance:check": "node scripts/check-conformance.mjs",
    "architecture:check": "depcruise packages --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm security:check && pnpm requirements:check && pnpm conformance:data:check && pnpm build:packages && pnpm conformance:check && pnpm performance:smoke && tsc --noEmit -p tsconfig.json && vitest run && pnpm build:site"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
