{
  "name": "@panefold/react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/styles.css",
    "./src/hide-single-tab-row.css"
  ],
  "files": [
    "dist",
    "src/styles.css",
    "src/hide-single-tab-row.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./styles.css": "./src/styles.css",
    "./hide-single-tab-row.css": "./src/hide-single-tab-row.css"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@panefold/geometry": "workspace:*",
    "@panefold/kernel": "workspace:*",
    "@panefold/model": "workspace:*",
    "@panefold/motion": "workspace:*",
    "@panefold/protocol-xstate": "workspace:*",
    "@panefold/runtime": "workspace:*",
    "use-sync-external-store": "1.6.0"
  },
  "devDependencies": {
    "@types/use-sync-external-store": "1.7.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "scripts": {
    "build": "tsup src/index.ts src/model.tsx --format esm --dts --splitting --clean --external react --external react-dom"
  }
}
