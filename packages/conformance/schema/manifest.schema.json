{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panefold.dev/schema/conformance-manifest-v1.json",
  "title": "Panefold conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["engineVersion", "classification", "profiles", "unsupported", "telemetryDefault"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "engineVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "classification": {
      "enum": ["stable", "experimental", "deprecated", "unsupported"]
    },
    "generatedAt": {
      "type": "string",
      "format": "date"
    },
    "profiles": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "unsupported": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "knownLimitations": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "telemetryDefault": {
      "const": "off"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {
            "const": "unsupported"
          }
        },
        "required": ["classification"]
      },
      "then": {
        "properties": {
          "profiles": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "profiles": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "const": "stable"
          }
        },
        "required": ["classification"]
      },
      "then": {
        "required": ["knownLimitations"]
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[a-z0-9]+(?:[.:_-][a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "framework", "browser", "surfaces", "inputs", "workload"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": ["stable", "experimental", "deprecated"]
        },
        "framework": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "browser": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "workload": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "accessibility": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  }
}
