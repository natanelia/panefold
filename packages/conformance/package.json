{
  "name": "@panefold/conformance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "schema"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest.schema.json": "./schema/manifest.schema.json",
    "./certification.schema.json": "./schema/certification.schema.json",
    "./certification.template.json": "./schema/certification.template.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  }
}
